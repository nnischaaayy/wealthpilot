# Local infra (infra/docker-compose.yml)
POSTGRES_USER=wealthpilot
POSTGRES_PASSWORD=wealthpilot
POSTGRES_DB=wealthpilot

# apps/web (Phase 1+) — see apps/web/.env.local (gitignored) for the actual local values
DATABASE_URL=postgresql://wealthpilot:wealthpilot@localhost:5432/wealthpilot
AUTH_SECRET=
# Optional — Google OAuth is disabled when these are unset
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AI_SERVICE_URL=http://localhost:8000
# Optional — Resend is used for budget-alert emails; unset means alerts stay in-app only
RESEND_API_KEY=
# Optional (Phase 8+) — rate limiting fails open (unlimited) when unset
REDIS_URL=redis://localhost:6379

# apps/ai-service (Phase 5+)
ANTHROPIC_API_KEY=
REDIS_URL=redis://localhost:6379
DATABASE_URL_AI=postgresql://wealthpilot:wealthpilot@localhost:5432/wealthpilot
# Voyage AI (Phase 6+) — embeddings for the RAG knowledge base. Without it,
# rag_lookup degrades gracefully; run `python -m rag.seed` after setting this
# to actually populate knowledge_articles.embedding.
VOYAGE_API_KEY=
# Free-tier fallback for both of the above — used only when ANTHROPIC_API_KEY /
# VOYAGE_API_KEY are unset. Get a key at https://aistudio.google.com (no card).
GEMINI_API_KEY=
