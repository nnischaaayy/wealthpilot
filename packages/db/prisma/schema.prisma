generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  owner
  member
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members       WorkspaceMember[]
  auditLogs     AuditLog[]
  accounts      Account[]
  transactions  Transaction[]
  categoryRules CategoryRule[]
  uploadJobs    UploadJob[]
  holdings      Holding[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // null for OAuth-only users (e.g. Google sign-in)
  name         String?
  createdAt    DateTime @default(now())

  memberships     WorkspaceMember[]
  auditLogActions AuditLog[]

  @@map("users")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(owner)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// Security-relevant actions (login, holdings edits, data export/delete, category-rule
// changes, ...) — append-only, never updated or deleted (§14).
model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  actorUserId  String
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

enum AccountType {
  checking
  savings
  credit
  brokerage
}

model Account {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  institution String?
  type        AccountType
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  uploadJobs   UploadJob[]
  holdings     Holding[]

  @@index([workspaceId])
  @@map("accounts")
}

enum TransactionSource {
  upload
  manual
  adapter
}

model Transaction {
  id                 String            @id @default(cuid())
  workspaceId        String
  accountId          String
  postedAt           DateTime
  amountMinor        Int // integer minor units (cents/paise); negative = spend, positive = income
  currency           String
  description        String
  merchantRaw        String?
  merchantNormalized String?
  category           String            @default("uncategorized")
  subcategory        String?
  source             TransactionSource @default(upload)
  redactedFieldsHash String? // populated by the AI redaction gateway (Phase 5+); unused until then
  createdAt          DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, postedAt])
  @@index([workspaceId, category])
  @@map("transactions")
}

model CategoryRule {
  id             String   @id @default(cuid())
  workspaceId    String
  matcherPattern String // case-insensitive substring matched against merchantNormalized/description
  category       String
  priority       Int      @default(0) // higher wins; user corrections are seeded above built-in defaults
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, matcherPattern])
  @@index([workspaceId, priority])
  @@map("category_rules")
}

enum UploadJobStatus {
  pending
  mapping_required
  processing
  done
  error
}

model UploadJob {
  id               String          @id @default(cuid())
  workspaceId      String
  accountId        String
  status           UploadJobStatus @default(pending)
  fileName         String
  detectedFormat   String?
  errorDetail      String?
  // Parsed rows + headers held only while status = mapping_required; cleared
  // once the import is confirmed so raw statement data isn't retained
  // longer than necessary.
  rawRowsJson      Json?
  columnMapping    Json?
  transactionCount Int?
  // Client-generated per-attempt key so a retried upload request replays the
  // existing job instead of double-importing (§9 idempotency convention).
  idempotencyKey   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("upload_jobs")
}

enum AssetClass {
  equity
  bond
  cash
  real_estate
  commodity
  crypto
  other
}

model Holding {
  id                String     @id @default(cuid())
  workspaceId       String
  accountId         String
  symbol            String
  name              String?
  quantity          Float // fractional shares/units allowed
  // Both prices are per-unit, integer minor units — costBasisMinor is the
  // average price paid; currentPriceMinor is manually entered/updated by the
  // user (v1 has no live market-data feed — see architecture.md §8
  // connectors/, planned for a later phase) and stays null until they set it.
  costBasisMinor    Int
  currentPriceMinor Int?
  currency          String
  assetClass        AssetClass @default(equity)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("holdings")
}

// Small, curated financial-education knowledge base for RAG (architecture.md
// §13.3) — not per-workspace data, so no workspaceId. embedding is
// Unsupported because pgvector isn't a Prisma-native type: the generated
// client never touches this column, ai-service reads/writes it directly via
// asyncpg (same read-only-relative-to-Prisma-schema pattern as
// tools/transactions.py and tools/holdings.py, except this table is also
// written to — by the offline seed script, not at request time).
model KnowledgeArticle {
  id        String                     @id @default(cuid())
  slug      String                     @unique
  title     String
  content   String
  embedding Unsupported("vector(512)")?
  createdAt DateTime                   @default(now())

  @@map("knowledge_articles")
}
